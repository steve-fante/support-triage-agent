# Copier ce fichier en .env puis renseigner la clé.
# .env est ignoré par git : aucune clé ne doit être committée.

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Curseur métier : au-dessus de ce seuil de confiance, la qualification part
# en traitement automatique. En dessous, elle passe en revue humaine.
SEUIL_CONFIANCE=0.75

# TEMPERATURE=0.0   # non transmis : deprecie par les modeles recents
MAX_TOKENS=1024
